# Quiet npm install output.
#   fund=false       — drops the "X packages are looking for funding" notice
#   audit-level=high — only surfaces high/critical audit findings
#
# Note: there is intentionally no `deprecation` entry here. In npm 10/11
# that key is not a recognized project config (npm prints
# "Unknown project config 'deprecation'" and ignores it), and there is
# no NPM_CONFIG_DEPRECATION env var that npm reads either. The working
# knob is the `--loglevel=error` CLI flag, which the Dockerfile applies
# directly on each `npm ci` invocation.
fund=false
audit-level=high

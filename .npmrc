# Quiet npm install output.
#
#   fund=false             — drops "X packages are looking for funding"
#   audit-level=high       — only surfaces high/critical audit findings
#   update-notifier=false  — drops the "New major version of npm
#                            available!" notice (this notice is
#                            emitted by the update-notifier module
#                            and is NOT controlled by --loglevel).
#
# Why no `deprecation` entry: that key is not a recognized project
# config in npm 10/11 (npm prints "Unknown project config
# 'deprecation'" and ignores it), and there is no
# NPM_CONFIG_DEPRECATION env var that npm reads. The working knob
# for `npm warn deprecated` is `--loglevel=error`, which the
# Dockerfile applies on each `npm ci` invocation.
fund=false
audit-level=high
update-notifier=false
